[Unit]
Description=Backup diario de apsis (pg_dump + off-site R2)
After=docker.service
Requires=docker.service
# Avisa al movil si el backup falla. El handler es del host y lo instala
# sesame-cli (scripts/systemd/install-onfailure.sh).
OnFailure=cartagena-notify@%n.service

[Service]
Type=oneshot
User=ductual
WorkingDirectory=/opt/apsis
ExecStart=/opt/apsis/ops/backup.sh
